<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.enjoytrip.member.model.mapper.MemberMapper">

    <resultMap id="memberResultMap" type="com.enjoytrip.member.model.dto.MemberDto">
        <id property="userId" column="user_id"/>
        <result property="userPassword" column="user_pwd"/>
        <result property="userName" column="user_name"/>
        <result property="email" column="email"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <select id="login" parameterType="string" resultMap="memberResultMap">
        SELECT user_id, user_pwd, user_name, email, created_at
        FROM member
        WHERE user_id = #{userId}
    </select>

    <select id="getMemberInfo" parameterType="string" resultMap="memberResultMap">
        SELECT user_id, user_pwd, user_name, email, created_at
        FROM member
        WHERE user_id = #{userId}
    </select>

    <insert id="signUp" parameterType="com.enjoytrip.member.model.dto.MemberDto">
        INSERT INTO member (user_id, user_pwd, user_name, email, created_at)
        VALUES (#{userId}, #{userPassword}, #{userName}, #{email}, NOW())
    </insert>

    <update id="updateMember" parameterType="com.enjoytrip.member.model.dto.MemberDto">
        UPDATE member
        <set>
            <if test="userPassword != null and userPassword != ''">
                user_pwd = #{userPassword},
            </if>
            <if test="userName != null and userName != ''">
                user_name = #{userName},
            </if>
            <if test="email != null and email != ''">
                email = #{email},
            </if>
        </set>
        WHERE user_id = #{userId}
    </update>

    <delete id="deleteMember" parameterType="string">
        DELETE FROM member
        WHERE user_id = #{userId}
    </delete>

    <select id="findPwd" parameterType="map" resultMap="memberResultMap">
        SELECT user_id, user_pwd, user_name, email, created_at
        FROM member
        WHERE user_name = #{name} AND email = #{email}
    </select>

</mapper>
