# =================================================
# 운영 배포용 환경변수 템플릿
#   서버에서 `cp .env.prod.example .env` 후 실제 값으로 채운다.
#   docker compose -f docker-compose.prod.yml 가 이 .env 를 읽는다.
#   ⚠️ .env 는 절대 커밋 금지(시크릿).
# =================================================

# --- DB ---
# 강한 비밀번호로. (DB_USERNAME 미지정 시 root)
DB_PASSWORD=change-me-strong-db-password

# --- JWT ---
# base64 256bit 키. 생성: openssl rand -base64 32
JWT_SECRET=change-me-base64-secret

# --- 접속 origin (CORS/WebSocket) ---
# 사용자가 브라우저로 접속하는 주소.
#   배포 직후(IP+HTTP):  http://<서버공인IP>
#   도메인+HTTPS 전환 후: https://<도메인>
# 여러 개면 콤마로: http://1.2.3.4,https://tripcrew.example.com
APP_CORS_ORIGINS=http://CHANGE_ME_PUBLIC_IP

# --- 프론트 빌드 ---
# 같은 origin 리버스 프록시(Caddy)면 상대경로 그대로 둔다(권장).
VITE_API_BASE_URL=/api

# --- 외부 API 키 ---
GEMINI_API_KEY=change-me
GEMINI_MODEL=gemini-3.1-flash-lite
# 네이버 지도(선택)
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=
VITE_NAVER_MAP_CLIENT_ID=

# --- (선택) JVM 메모리 튜닝 ---
# 메모리 작은 인스턴스면 낮춰서: -Xmx512m
# JAVA_OPTS=-XX:MaxRAMPercentage=70
