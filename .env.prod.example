# =================================================
# 운영 배포용 환경변수 템플릿
#   서버에서 `cp .env.prod.example .env` 후 실제 값으로 채운다.
#   docker compose -f docker-compose.prod.yml 가 이 .env 를 읽는다.
#   ⚠️ .env 는 절대 커밋 금지(시크릿).
# =================================================

# --- DB ---
# 강한 비밀번호로. (DB_USERNAME 미지정 시 root)
DB_PASSWORD=change-me-strong-db-password

# --- JWT ---
# base64 256bit 키. 생성: openssl rand -base64 32
JWT_SECRET=change-me-base64-secret

# --- 접속 origin (CORS/WebSocket) ---
# 사용자가 브라우저로 접속하는 주소.
#   배포 직후(IP+HTTP):  http://<서버공인IP>
#   도메인+HTTPS 전환 후: https://<도메인>
# 여러 개면 콤마로: http://1.2.3.4,https://tripcrew.example.com
APP_CORS_ORIGINS=https://tripcrew.duckdns.org

# --- 프론트 빌드 ---
# 같은 origin 리버스 프록시(Caddy)면 상대경로 그대로 둔다(권장).
VITE_API_BASE_URL=/api

# --- 외부 API 키 ---
GEMINI_API_KEY=change-me
GEMINI_MODEL=gemini-3.1-flash-lite
# 네이버 지도(선택)
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=
VITE_NAVER_MAP_CLIENT_ID=

# --- JVM 메모리 (t2.micro 1GB 기준 하드캡) ---
# 더 큰 인스턴스면 올린다(예: -Xmx768m 또는 -XX:MaxRAMPercentage=70).
JAVA_OPTS=-Xmx384m

# --- OAuth2 소셜 로그인 (Kakao / Naver) ---
# 제공자 콘솔에서 발급(Kakao=REST API 키 + Client Secret 활성화, Naver=Client ID/Secret).
# 콘솔 redirect URI 에 운영 주소 등록 필수:
#   https://tripcrew.duckdns.org/login/oauth2/code/kakao
#   https://tripcrew.duckdns.org/login/oauth2/code/naver
KAKAO_CLIENT_ID=change-me-kakao-rest-api-key
KAKAO_CLIENT_SECRET=change-me-kakao-client-secret
NAVER_CLIENT_ID=change-me-naver-client-id
NAVER_CLIENT_SECRET=change-me-naver-client-secret
# 소셜 로그인 성공 후 돌아갈 프론트 베이스(운영 도메인)
APP_OAUTH_REDIRECT_BASE=https://tripcrew.duckdns.org

# --- (로컬 빌드→푸시 방식 쓸 때만) 이미지 레지스트리 prefix ---
# 본인 Docker Hub 사용자명. EC2 직접 빌드만 할 거면 무시해도 됨.
# IMAGE_PREFIX=your-dockerhub-username
