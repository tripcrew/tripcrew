# =================================================
# 운영용 프론트 이미지 (멀티스테이지)
#   build: Vite 정적 빌드 (VITE_* 는 빌드시점에 번들에 박힘 → build arg 로 주입)
#   run : Caddy 로 SPA 정적 서빙 + 백엔드 리버스 프록시 (한 컨테이너가 80 포트 담당)
# =================================================

# ---- build stage ----
FROM node:20-alpine AS build
WORKDIR /app

COPY package*.json ./
RUN npm install

COPY . .

# API base 는 상대경로(/api) 기본 → 같은 origin 리버스 프록시라 CORS 불필요.
# IP↔도메인, HTTP↔HTTPS 전환 시에도 프론트 재빌드 불필요(런타임 origin 사용).
ARG VITE_API_BASE_URL=/api
ARG VITE_NAVER_MAP_CLIENT_ID=
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_NAVER_MAP_CLIENT_ID=$VITE_NAVER_MAP_CLIENT_ID
RUN npm run build

# ---- run stage (Caddy) ----
FROM caddy:2-alpine
COPY --from=build /app/dist /srv
COPY Caddyfile /etc/caddy/Caddyfile
EXPOSE 80
