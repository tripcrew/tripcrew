MYSQL_DATABASE=tripcrew
# 로컬 MySQL 이 3306 을 쓰면 충돌하므로 다른 포트(예: 3307)로. 백엔드는 컨테이너망 mysql:3306 사용이라 무관.
MYSQL_PORT=3306

DB_URL=jdbc:mysql://mysql:3306/tripcrew?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=root
# mysql 컨테이너의 root 비밀번호이자 백엔드 접속 비밀번호 (compose 가 둘을 같은 값으로 초기화).
# 실제 값은 .env 에만 넣는다. 이 파일(.env.example)은 커밋되므로 진짜 비번을 적지 말 것.
DB_PASSWORD=your_db_password

JWT_SECRET=replace_with_openssl_rand_base64_32

BACKEND_PORT=8080
VITE_API_BASE_URL=http://localhost:8080/api
VITE_NAVER_MAP_CLIENT_ID=your_naver_map_client_id

# NAVER Directions 5 REST API credentials. Keep the secret backend-only.
NAVER_MAP_CLIENT_ID=your_naver_map_client_id
NAVER_MAP_CLIENT_SECRET=your_naver_map_client_secret

GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash-lite

# OAuth2 소셜 로그인 (Kakao / Naver). 위 NAVER_MAP_* (지도)와는 별개 자격증명.
#   제공자 콘솔에서 발급(Kakao=REST API 키, Naver=Client ID/Secret).
#   미설정 시 앱은 기동되나 해당 소셜 로그인만 동작 안 함.
#   콘솔 redirect URI: 로컬 http://localhost:8080/login/oauth2/code/{kakao|naver}
#                      운영 https://tripcrew.duckdns.org/login/oauth2/code/{kakao|naver}
KAKAO_CLIENT_ID=your_kakao_rest_api_key
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=your_naver_login_client_id
NAVER_CLIENT_SECRET=your_naver_login_client_secret
# 소셜 로그인 성공 후 돌아갈 프론트 베이스 URL (운영=https://tripcrew.duckdns.org)
APP_OAUTH_REDIRECT_BASE=http://localhost:5173
